{
    "name": "justinholtweb/craft-book",
    "description": "Embed any document in Craft CMS — PDFs, Word, Excel, PowerPoint, OpenDocument, CSV, Markdown, images and more, in Twig or in rich text, with native, Google, Office or server-rendered viewers.",
    "version": "5.0.0",
    "type": "craft-plugin",
    "keywords": [
        "craftcms",
        "craft-plugin",
        "pdf",
        "document",
        "embed",
        "viewer",
        "docx",
        "xlsx",
        "office"
    ],
    "license": "proprietary",
    "authors": [
        {
            "name": "Justin Holt",
            "homepage": "https://justinholt.com"
        }
    ],
    "support": {
        "email": "justin@justinholt.com"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "craftcms/cms": "^5.3.0"
    },
    "autoload": {
        "psr-4": {
            "justinholtweb\\book\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "justinholtweb\\book\\tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true
        }
    },
    "extra": {
        "name": "Book",
        "handle": "book",
        "developer": "Justin Holt",
        "developerUrl": "https://justinholt.com",
        "documentationUrl": "https://github.com/justinholtweb/craft-book/blob/main/README.md",
        "changelogUrl": "https://raw.githubusercontent.com/justinholtweb/craft-book/main/CHANGELOG.md",
        "class": "justinholtweb\\book\\Plugin"
    }
}
